{
 "gruppen": [
  {
   "key": "iaido|Kamae (Schwertkampf)",
   "text": "Die hier dargestellten Formen beziehen sich auf die Schwertkampf-Kamae. In diesem Lehrwerk werden alleinig diese behandelt, weil diese bis zum Erreichen der höheren Grade wesentlich sind und die Grundlage für weitere Waffengattungen bilden. Das Konzept der Kamae ist nicht als starre Form zu betrachten. Kamae ist dynamisch und nicht statisch. Wir fließen von einer Kamae in die nächste Kamae.",
   "quelle": "Lehrwerk S. 14",
   "abschnitt": "l-3-2",
   "seite": 14
  },
  {
   "key": "iaido|Tameshigiri: sieben furidome-Techniken",
   "text": "Im Tameshigiri gibt es sieben furidome Techniken, in denen der Schnitt in der tome Position stoppt. Die Fertigkeit des Schwertkämpfers ist durch den korrekten Schnittwinkel von 35° bis max. 45° erkennbar. Das Ziel sollte komplett durchtrennt sein und die Schnittfläche glatt und sauber.",
   "quelle": "Lehrwerk S. 15",
   "abschnitt": "l-3-3",
   "seite": 15
  },
  {
   "key": "karate|Kata",
   "text": "Geprüft wird die Anwendung der Grundblöcke, Grundschläge und Grundbewegungen in den Kata Taikyoku Sono (Ichi/Ni/San).",
   "quelle": "Prüfungsordnung",
   "abschnitt": "l-3-1",
   "seite": null
  },
  {
   "key": "karate|Kitae (Abhärtung)",
   "text": "Das Kitae (schmieden, trainieren, stählen) kann nach Anleitung sowohl ganz allein praktiziert werden, als auch mit einem Partner. Die drei Bereiche sind hierbei Kote Kitae (Arme), Hara Kitae (Bauch) und Ashi Kitae (Bein/Fuß). Hierbei gilt es zu unterscheiden, welchen Grad der Abhärtung der Mitschüler bereits erreicht hat.",
   "quelle": "Lehrwerk S. 16",
   "abschnitt": "l-3-4-1",
   "seite": 16
  },
  {
   "key": "jiujitsu|Ukemi (Fallschule)",
   "text": "Allen Fallarten ist gemein, dass die Fallenergie durch die Berührung der Hand auf den Boden übertragen wird. Die Fallhöhe sollte in jedem Fall minimiert werden, um die Stärke des Auftreffens so gering wie möglich zu halten. Der Kopf berührt in keinem Fall den Boden, da sonst auf der Straße schwere Verletzungen entstehen werden, welche nicht nur zum sofortigen Kampfabbruch führen, sondern auch zu Folgeschäden, welche dauerhafte Einschränkungen mit sich bringen können.",
   "quelle": "Lehrwerk S. 13",
   "abschnitt": "l-3-1-1",
   "seite": 13
  },
  {
   "key": "karate|Beinwaffen (Teile des Beins)",
   "text": "Die Teile des Beins, mit denen getreten oder gestoßen wird.",
   "quelle": "Ergänzung (West Island Karate)",
   "abschnitt": "l-3-1",
   "seite": null
  },
  {
   "key": "karate|Tritte (Geri)",
   "text": "Liste der Tritte nach einer Kyokushin-Quelle. Die Ausführung lernst du beim Lehrer. Schreibweisen und Bezeichnungen können je nach Verband abweichen, im YKR gilt die Bezeichnung der Schule.",
   "quelle": "Ergänzung (West Island Karate)",
   "abschnitt": "l-3-1",
   "seite": null
  },
  {
   "key": "karate|Stände (Tachikata)",
   "text": "Liste der Stände nach einer Kyokushin-Quelle. Die Zuordnung zu den Prüfungsgraden legt die Schule fest.",
   "quelle": "Ergänzung (West Island Karate)",
   "abschnitt": "l-3-1",
   "seite": null
  }
